# Copy this file to .env.local. Use literal values after the first '='.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=petspa;Username=postgres;Password=<password>
Jwt__Issuer=PetSpa.Api
Jwt__Audience=PetSpa.Client
Jwt__SigningKey=
Jwt__AccessTokenMinutes=15
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
AllowedHosts=*
# Uncomment to override the listen addresses set by the launch profile.
# URLS=http://localhost:5052
