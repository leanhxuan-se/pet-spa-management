{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=petspa;Username=postgres;Password=<password>"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "PetSpa.Api",
    "Audience": "PetSpa.Client",
    "SigningKey": "<replace-with-a-secret-of-at-least-32-bytes>",
    "AccessTokenMinutes": 15
  },
  "AllowedHosts": "*"
}
