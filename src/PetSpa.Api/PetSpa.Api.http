@PetSpa.Api_HostAddress = http://localhost:5052
@phone = 0900000001
@password = Example-passphrase-001
@accessToken = paste-login-token
@frontDeskToken = paste-receptionist-or-manager-token
@activationToken = paste-activation-token
@customerId = 1

GET {{PetSpa.Api_HostAddress}}/health

###

POST {{PetSpa.Api_HostAddress}}/api/auth/customers/{{customerId}}/activation
Authorization: Bearer {{frontDeskToken}}

###

POST {{PetSpa.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "phone": "{{phone}}",
  "password": "{{password}}",
  "activationToken": "{{activationToken}}"
}

###

POST {{PetSpa.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "phone": "{{phone}}",
  "password": "{{password}}"
}

###

POST {{PetSpa.Api_HostAddress}}/api/auth/logout
Authorization: Bearer {{accessToken}}
